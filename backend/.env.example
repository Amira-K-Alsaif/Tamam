# Copy to backend/.env and fill in locally. Never commit backend/.env.
TAMAM_CORS_ORIGINS=["http://localhost:5173"]

# Added when each integration lands:
# TAMAM_DATABASE_URL=postgresql://...
# TAMAM_GOOGLE_API_KEY=

# The Gemini model, and the one that answers when it is busy. Empty fallback turns it off.
# TAMAM_LLM_MODEL=gemini-3.6-flash
# TAMAM_LLM_FALLBACK_MODEL=gemini-3.5-flash

# Supabase (knowledge and career). The secret key stays on the backend only.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SECRET_KEY=

# The company whose documents Tamam answers from.
# TAMAM_COMPANY_NAME=شركة نخلة للتقنية

# Load the chat's models at startup instead of on the first question.
# Needs: pip install -e ".[dev,rag]"
# TAMAM_WARM_UP_MODELS=true
